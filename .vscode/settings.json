Deno.serve(async (req) => {
  try {
    const payload = await req.json();
    console.log("Incoming Supabase Auth payload:", JSON.stringify(payload));

    // Extract phone number and OTP generated by Supabase
    const phone = payload.user?.phone || payload.phone;
    const otpCode = payload.sms?.otp || payload.otp;

    const apiKey = Deno.env.get("pingram_sk_eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiJrZXlfMGU5NGM2MTRkMjYwMGUzOWIzMzA3YTMwNzRhODRiZmYiLCJ2ZXJzaW9uIjoxLCJhY2NvdW50SWQiOiJydGpjZ2F1NnVraHNqYnVxNWV4OWFkdDQ3dyIsImtleVR5cGUiOiJzZWNyZXQiLCJlbnZpcm9ubWVudElkIjoicnRqY2dhdTZ1a2hzamJ1cTVleDlhZHQ0N3cifQ.iUjXF2_hJx2Y-JHbXn2-z4rpbeG8Vl5JEl2x0sl7a6Y");
    if (!apiKey) {
      throw new Error("PINGRAM_API_KEY secret is missing in Supabase!");
    }

    // Send the SMS via Pingram API endpoint
    const pingramResponse = await fetch("https://api.pingram.io/v1/messages", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${apiKey}`
      },
      body: JSON.stringify({
        type: "otp_delivery", // Logical identifier for Pingram dashboard logs
        to: { 
          number: phone 
        },
        sms: { 
          message: `Your Sarkar Seva verification code is: ${otpCode}. Valid for 10 minutes.` 
        }
      })
    });

    const responseText = await pingramResponse.text();
    console.log("Pingram response status:", pingramResponse.status, responseText);

    if (!pingramResponse.ok) {
      throw new Error(`Pingram API rejected request: ${responseText}`);
    }

    return new Response(JSON.stringify({ success: true }), { 
      status: 200,
      headers: { "Content-Type": "application/json" }
    });

  } catch (error) {
    console.error("Error in pingram-sms function:", error.message);
    return new Response(JSON.stringify({ error: error.message }), { 
      status: 500,
      headers: { "Content-Type": "application/json" }
    });
  }
});